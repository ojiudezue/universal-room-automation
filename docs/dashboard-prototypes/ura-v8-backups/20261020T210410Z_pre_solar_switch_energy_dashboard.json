                              },
                              "secondary": "#7",
                              "icon_color": "{% if states('sensor.encharge_492451006223_battery')|int > 50 %}green{% elif states('sensor.encharge_492451006223_battery')|int > 20 %}amber{% else %}red{% endif %}",
                              "tap_action": {
