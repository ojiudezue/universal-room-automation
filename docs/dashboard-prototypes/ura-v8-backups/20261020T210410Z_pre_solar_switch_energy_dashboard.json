                                "entity": "sensor.encharge_492451006223_battery"
                              }
                            },
                            {
                              "icon": "mdi:battery",
                              "type": "custom:mushroom-template-card",
                              "layout": "vertical",
                              "primary": "{{ states('sensor.encharge_492451006228_battery') }}%",
                              "card_mod": {
                                "style": "ha-card { background: linear-gradient(180deg, rgba(76, 175, 80, 0.4), rgba(76, 175, 80, 0.15)); border: 2px solid rgba(76, 175, 80, 0.6); border-radius: 10px; }"
                              },
                              "secondary": "#8",
                              "icon_color": "{% if states('sensor.encharge_492451006228_battery')|int > 50 %}green{% elif states('sensor.encharge_492451006228_battery')|int > 20 %}amber{% else %}red{% endif %}",
