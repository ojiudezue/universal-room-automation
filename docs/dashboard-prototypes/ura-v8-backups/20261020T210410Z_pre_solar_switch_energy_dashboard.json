{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.energy_dashboard",
  "data": {
    "config": {
      "views": [
        {
          "path": "energy",
          "type": "panel",
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "custom:mushroom-chips-card",
                  "chips": [
                    {
                      "icon": "mdi:solar-power",
                      "type": "template",
                      "content": "{{ states('sensor.envoy_482543015950_current_power_production')|float|round(2) }} kW\nSOLAR",
                      "icon_color": "orange",
                      "tap_action": {
                        "action": "more-info",
                        "entity": "sensor.envoy_482543015950_current_power_production"
                      }
                    },
                    {
                      "icon": "mdi:battery",
                      "type": "template",
                      "content": "{{ states('sensor.envoy_482543015950_battery')|float|round(0) }}%\nBATTERY",
                      "icon_color": "green",
                      "tap_action": {
                        "action": "more-info",
                        "entity": "sensor.envoy_482543015950_battery"
                      }
                    },
                    {
                      "icon": "mdi:home-lightning-bolt",
                      "type": "template",
                      "content": "{{ states('sensor.envoy_482543015950_current_power_consumption')|float|round(2) }} kW\nHOME",
                      "icon_color": "blue",
                      "tap_action": {
                        "action": "more-info",
                        "entity": "sensor.envoy_482543015950_current_power_consumption"
                      }
                    },
                    {
                      "icon": "mdi:weather-sunny",
                      "type": "template",
                      "content": "{{ states('sensor.solcast_pv_forecast_forecast_today')|float|round(1) }} kWh\nFORECAST",
                      "icon_color": "amber",
                      "tap_action": {
                        "action": "more-info",
                        "entity": "sensor.solcast_pv_forecast_forecast_today"
                      }
                    },
                    {
                      "icon": "mdi:currency-usd",
                      "type": "template",
                      "content": "${{ ((states('sensor.mains_vue_3_mainsfromgrid_energy_this_month')|float(0) * 0.098355) + 32.50)|round(2) }}\nEST. COST",
                      "icon_color": "teal"
                    },
                    {
                      "icon": "mdi:engine",
                      "type": "template",
                      "content": "{{ states('sensor.generac_2325624_status_2') }}\nGENERATOR",
                      "icon_color": "{% if is_state('sensor.generac_2325624_status_2', 'Running') %}red{% elif is_state('sensor.generac_2325624_status_2', 'Ready') %}teal{% else %}grey{% endif %}",
                      "tap_action": {
                        "action": "more-info",
                        "entity": "sensor.generac_2325624_status_2"
                      }
                    }
                  ],
                  "card_mod": {
                    "style": "ha-card { background: #252525; border-bottom: 1px solid #444; padding: 16px 0; } .chip { background: #333 !important; padding: 12px 20px !important; border-radius: 12px !important; }"
                  },
                  "alignment": "center"
                },
                {
                  "type": "horizontal-stack",
                  "cards": [
                    {
                      "type": "custom:power-flow-card-plus",
                      "card_mod": {
                        "style": "ha-card { background: #252525; border: 1px solid #444; border-radius: 16px; }"
                      },
                      "entities": {
                        "grid": {
                          "icon": "mdi:transmission-tower",
                          "name": "Grid",
                          "color": {
                            "production": [
                              156,
                              204,
                              101
                            ],
                            "consumption": [
                              171,
                              71,
                              188
                            ]
                          },
                          "entity": "sensor.mains_vue_3_power_minute_average",
                          "color_icon": true,
                          "display_state": "two_way"
                        },
                        "home": {
                          "icon": "mdi:home",
                          "name": "Home",
                          "color": [
                            66,
                            165,
                            245
                          ],
                          "entity": "sensor.envoy_482543015950_current_power_consumption",
                          "color_icon": true
                        },
                        "solar": {
                          "icon": "mdi:solar-power",
                          "name": "Solar",
                          "color": [
                            255,
                            167,
                            38
                          ],
                          "entity": "sensor.envoy_482543015950_current_power_production",
                          "color_icon": true,
                          "display_zero_state": true
                        },
                        "battery": {
                          "icon": "mdi:battery",
                          "name": "Battery",
                          "color": {
                            "production": [
                              102,
                              187,
                              106
                            ],
                            "consumption": [
                              102,
                              187,
                              106
                            ]
                          },
                          "entity": "sensor.envoy_482543015950_current_battery_discharge",
                          "color_icon": true,
                          "display_state": "two_way",
                          "state_of_charge": "sensor.envoy_482543015950_battery"
                        }
                      },
                      "w_decimals": 0,
                      "kw_decimals": 2,
                      "max_flow_rate": 6,
                      "min_flow_rate": 0.75,
                      "watt_threshold": 0,
                      "clickable_entities": true,
                      "display_zero_lines": {
                        "mode": "show",
                        "grey_color": [
                          100,
                          100,
                          100
                        ],
                        "transparency": 50
                      },
                      "use_new_flow_rate_model": true
                    },
                    {
                      "type": "vertical-stack",
                      "cards": [
                        {
                          "type": "markdown",
                          "content": "## Billing Period (24th-24th)\n##### Day {{ ((now().day - 24) % 30) + 1 }} of 30",
                          "card_mod": {
                            "style": "ha-card { background: transparent; padding: 8px 16px; }"
                          }
                        },
                        {
                          "icon": "mdi:transmission-tower-import",
                          "type": "custom:mushroom-template-card",
                          "layout": "horizontal",
                          "primary": "{{ states('sensor.mains_vue_3_mainsfromgrid_energy_this_month')|float|round(1) }} kWh",
                          "card_mod": {
                            "style": "ha-card { background: linear-gradient(135deg, rgba(171, 71, 188, 0.3), rgba(171, 71, 188, 0.1)); border: 1px solid rgba(171, 71, 188, 0.5); border-radius: 12px; }"
                          },
                          "secondary": "Grid Import MTD",
                          "icon_color": "purple",
                          "tap_action": {
                            "action": "more-info",
                            "entity": "sensor.mains_vue_3_mainsfromgrid_energy_this_month"
                          }
                        },
                        {
                          "icon": "mdi:transmission-tower-export",
                          "type": "custom:mushroom-template-card",
                          "layout": "horizontal",
                          "primary": "{{ states('sensor.mains_vue_2_mainstogrid_energy_this_month')|float|round(1) }} kWh",
                          "card_mod": {
                            "style": "ha-card { background: linear-gradient(135deg, rgba(156, 204, 101, 0.3), rgba(156, 204, 101, 0.1)); border: 1px solid rgba(156, 204, 101, 0.5); border-radius: 12px; }"
                          },
                          "secondary": "Grid Export MTD",
