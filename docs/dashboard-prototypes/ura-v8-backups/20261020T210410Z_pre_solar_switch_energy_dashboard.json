                        }
                      ]
                    },
                    {
                      "type": "vertical-stack",
                      "cards": [
                        {
                          "type": "markdown",
                          "content": "## 💡 Smart Recommendations",
                          "card_mod": {
                            "style": "ha-card { background: transparent; padding: 8px 16px; }"
                          }
                        },
                        {
                          "type": "markdown",
                          "content": "{% set forecast = states('sensor.solcast_pv_forecast_forecast_remaining_today')|float(0) %}{% set battery = states('sensor.envoy_482543015950_battery')|float(0) %}{% set hour = now().hour %}{% if forecast > 10 and battery < 90 %}🔋 **Batteries charging** - {{ forecast|round(1) }} kWh remaining today\n\n{% endif %}{% if forecast > 5 and hour < 16 %}🚗 **EV Charging Window** - 11 AM to 4 PM optimal\n\n{% endif %}{% if battery > 80 and hour >= 17 %}❄️ **Pre-cool House** - Battery at {{ battery }}%, use before peak\n\n{% endif %}{% if forecast < 3 %}⚠️ **Low Solar Day** - Defer heavy loads to preserve battery{% elif forecast <= 5 %}☁️ **Moderate Solar** - {{ forecast|round(1) }} kWh remaining{% else %}☀️ **Good Solar Day** - {{ forecast|round(1) }} kWh expected{% endif %}",
                          "card_mod": {
                            "style": "ha-card { background: linear-gradient(135deg, rgba(255, 193, 7, 0.2), rgba(76, 175, 80, 0.15)); border: 1px solid rgba(255, 193, 7, 0.5); border-radius: 12px; }"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "markdown",
                      "content": "## ☀️ Solar Production: Forecast vs Actual",
                      "card_mod": {
                        "style": "ha-card { background: transparent; padding: 8px 16px; }"
                      }
                    },
                    {
                      "type": "custom:apexcharts-card",
                      "header": {
                        "show": false
                      },
                      "graph_span": "24h",
                      "span": {
                        "start": "day"
                      },
                      "now": {
                        "show": true,
                        "label": "Now",
                        "color": "#ffffff"
                      },
                      "apex_config": {
                        "chart": {
                          "height": 200,
                          "background": "transparent"
                        },
                        "grid": {
                          "borderColor": "#444"
                        },
                        "legend": {
                          "show": true,
                          "position": "top",
                          "labels": {
                            "colors": "#ffffff"
                          }
                        },
                        "xaxis": {
                          "labels": {
                            "style": {
                              "colors": "#aaa"
                            }
                          },
                          "axisBorder": {
                            "color": "#444"
                          }
                        },
                        "yaxis": {
                          "labels": {
                            "style": {
                              "colors": "#aaa"
                            }
                          }
                        },
                        "tooltip": {
                          "theme": "dark"
                        }
                      },
                      "series": [
                        {
                          "entity": "sensor.solcast_pv_forecast_forecast_today",
                          "name": "Forecast",
                          "type": "area",
                          "color": "#FFD54F",
                          "opacity": 0.4,
                          "stroke_width": 2,
                          "curve": "smooth",
                          "data_generator": "const data = []; const fc = entity.attributes.detailedHourly; if (fc) { fc.forEach(f => { data.push([new Date(f.period_start).getTime(), f.pv_estimate]); }); } return data;"
                        },
                        {
                          "entity": "sensor.envoy_482543015950_current_power_production",
                          "name": "Actual",
                          "type": "line",
                          "color": "#FFA726",
                          "stroke_width": 3,
                          "curve": "smooth",
                          "extend_to": "now"
                        }
                      ],
                      "card_mod": {
                        "style": "ha-card { background: #252525; border: 1px solid #444; border-radius: 12px; }"
                      }
                    }
                  ]
                },
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "markdown",
                      "content": "## ☀️ Microinverters (50 Panels)\n##### 24.25 kW System • QCell 485W • Sorted by Output",
                      "card_mod": {
                        "style": "ha-card { background: transparent; padding: 8px 16px; }"
                      }
                    },
                    {
                      "card": {
                        "type": "glance",
                        "columns": 10,
                        "show_icon": true,
                        "show_name": false,
                        "show_state": true,
                        "state_color": false
                      },
                      "sort": {
                        "method": "state",
                        "numeric": true,
                        "reverse": true
                      },
                      "type": "custom:auto-entities",
                      "filter": {
                        "exclude": [
                          {
                            "entity_id": "*ac_current*"
                          },
                          {
                            "entity_id": "*lifetime*"
                          },
                          {
                            "entity_id": "*energy_production*"
                          }
                        ],
                        "include": [
                          {
                            "entity_id": "sensor.inverter_5424*",
                            "attributes": {
                              "device_class": "power"
                            }
                          }
                        ]
                      },
                      "card_mod": {
                        "style": "ha-card { background: #252525; border: 1px solid #444; border-radius: 12px; padding: 12px; } .entity { padding: 6px 2px !important; } .state { font-size: 11px !important; color: #FFA726 !important; } ha-state-icon { color: #FFA726 !important; }"
                      }
                    }
                  ]
                }
              ],
              "card_mod": {
                "style": "ha-card { background: #1a1a1a; padding: 16px; }"
              }
            }
          ],
          "title": "Energy",
          "background": "#1a1a1a"
        }
      ]
    }
