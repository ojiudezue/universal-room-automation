                          "card_mod": {
                            "style": "ha-card { background: linear-gradient(135deg, rgba(255, 167, 38, 0.3), rgba(255, 167, 38, 0.1)); border: 1px solid rgba(255, 167, 38, 0.5); border-radius: 12px; }"
                          },
                          "secondary": "Solar Today",
                          "icon_color": "orange",
                          "tap_action": {
                            "action": "more-info",
                            "entity": "sensor.envoy_482543015950_energy_production_today"
                          }
                        },
                        {
                          "icon": "mdi:currency-usd",
                          "type": "custom:mushroom-template-card",
                          "layout": "horizontal",
                          "primary": "${{ ((states('sensor.mains_vue_3_mainsfromgrid_energy_this_month')|float(0) * 0.098355) + 32.50)|round(2) }}",
                          "card_mod": {
                            "style": "ha-card { background: linear-gradient(135deg, rgba(38, 166, 154, 0.3), rgba(38, 166, 154, 0.1)); border: 1px solid rgba(38, 166, 154, 0.5); border-radius: 12px; }"
                          },
                          "secondary": "Estimated Grid Cost",
                          "icon_color": "teal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "horizontal-stack",
                  "cards": [
                    {
                      "type": "vertical-stack",
                      "cards": [
                        {
                          "type": "markdown",
